[Unit]
Description=Duranta preview Podman stack
After=network-online.target user@1000.service
Wants=network-online.target user@1000.service

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=30min
User=ubuntu
Group=ubuntu
Environment=HOME=/home/ubuntu
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
ExecStart=/usr/local/bin/duranta-preview-stack up
ExecStop=/usr/local/bin/duranta-preview-stack down

[Install]
WantedBy=multi-user.target
